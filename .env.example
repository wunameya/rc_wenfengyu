APP_DATABASE_URL=mysql+pymysql://notification:notification@127.0.0.1:3306/notification?charset=utf8mb4
APP_CHANNEL_CONFIG_PATH=config/channels.json
APP_WORKER_PROCESSES=2
APP_WORKER_CONFIG_POLL_INTERVAL_SECONDS=2
APP_MAX_DELIVERY_RETRIES=10
APP_WORKER_POLL_INTERVAL_SECONDS=1
APP_WORKER_BATCH_SIZE=20
APP_WORKER_CONCURRENCY=10
APP_WORKER_LEASE_SECONDS=60
APP_RESPONSE_EXCERPT_LENGTH=2000
APP_CORS_ORIGINS=http://localhost:5173
APP_TEST_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# 进程总并发约为 APP_WORKER_PROCESSES * APP_WORKER_CONCURRENCY。
# 多 Worker 必须共用同一个 MySQL，不能使用 SQLite。

# 渠道配置中的 secret_headers 从环境变量读取，例如：
# CRM_API_TOKEN=replace-me

